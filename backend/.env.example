# ---------------------------------------------------------------------------
# Laboratory Management System - backend configuration
# Copy this file to `.env` and adjust the values for your environment.
# NEVER commit the real `.env` file.
# ---------------------------------------------------------------------------

# HTTP server
PORT=4000
NODE_ENV=development

# Authentication / security
JWT_SECRET=replace-with-a-long-random-secret-string
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# MongoDB Atlas
MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DATABASE=MediCoreLIS

# Comma separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Uploads (lab logo, avatars)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=2
BLOB_READ_WRITE_TOKEN=

# Default credentials created on first boot (change immediately)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@123
